{
  "name": "agentlintel",
  "version": "2.0.0-alpha.12",
  "private": true,
  "description": "AgentLintel - deterministic architecture gate for AI-agent codebases. Monorepo root.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/lishan-fernando/AGENTLINTEL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishan-fernando/AGENTLINTEL.git"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agents",
    "architecture",
    "software-architecture",
    "architecture-tests",
    "ci",
    "github-actions",
    "code-quality",
    "static-analysis",
    "lint",
    "agents-md",
    "agent-skills",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "devtools",
    "agentlintel"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "npm run check --prefix tools/agentlintel-cli",
    "ci": "npm ci --no-audit --no-fund --prefix tools/agentlintel-cli && npm run release:check",
    "test": "npm test --prefix tools/agentlintel-cli",
    "verify:self": "node tools/agentlintel-cli/bin/agentlintel.js verify --dir .",
    "verify:strict": "node tools/agentlintel-cli/bin/agentlintel.js verify --dir . --strict --base HEAD~1",
    "pack:dry-run": "npm run pack:dry-run --prefix tools/agentlintel-cli",
    "release:check": "npm run release:check --prefix tools/agentlintel-cli"
  },
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {},
  "author": "Muthuthanthrige Lishan Waruna Pramodh Fernando",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lishan-fernando/AGENTLINTEL/issues"
  }
}
